datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String?
  link        String?
  github      String?
  tags        String[]
  createdAt   DateTime @default(now())
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Booking {
  id          String   @id @default(cuid())
  serviceId   String
  name        String
  email       String
  date        String
  time        String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}
